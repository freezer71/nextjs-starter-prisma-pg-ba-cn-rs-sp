# ---------------------------------------------------------------------------
# Copier ce fichier en .env et renseigner les valeurs.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur : jamais de secret.
# ---------------------------------------------------------------------------

# URL publique de l'application (sans slash final). Sert aussi de baseURL Better Auth.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Base de données (Postgres) --------------------------------------------
# Variables lues par docker-compose.yml pour la base locale.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="starter"
POSTGRES_PORT="5432"
# Chaîne de connexion utilisée par Prisma (Prisma Postgres : postgres://...@db.prisma.io:5432/postgres?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starter?schema=public"

# --- Better Auth -----------------------------------------------------------
# Secret de signature (32+ caractères) : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Origines supplémentaires autorisées (CSRF), séparées par des virgules. Optionnel.
# BETTER_AUTH_TRUSTED_ORIGINS="https://app.example.com,https://*.preview.example.com"

# --- Emails (Resend) -------------------------------------------------------
# Sans clé en développement, les emails sont affichés dans la console du serveur.
RESEND_API_KEY=""
# Expéditeur : le domaine doit être vérifié dans Resend (onboarding@resend.dev en test).
EMAIL_FROM="Starter <onboarding@resend.dev>"

# --- Stripe ----------------------------------------------------------------
# Préférer une clé restreinte (rk_...) à une clé secrète (sk_...).
STRIPE_SECRET_KEY=""
# Secret de signature du webhook (stripe listen l'affiche au démarrage).
STRIPE_WEBHOOK_SECRET=""
# Price ID Stripe du plan d'exemple (mode abonnement). Optionnel.
STRIPE_PRICE_PRO_MONTHLY=""
